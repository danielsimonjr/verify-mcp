{
  "mcpServers": {
    "verify": {
      "type": "stdio",
      "command": "bun",
      "args": ["${CLAUDE_PLUGIN_ROOT}/bundle/index.mjs"],
      "env": {
        "VERIHARNESS_BIN": "~/Github/verify/harness/cli.ts",
        "VERIFY_MCP_PROVIDER": "${VERIFY_MCP_PROVIDER:-}",
        "VERIFY_MCP_MODEL": "${VERIFY_MCP_MODEL:-}",
        "VERIFY_MCP_BASE_URL": "${VERIFY_MCP_BASE_URL:-}",
        "VERIFY_MCP_CONTEXT_SIZE": "${VERIFY_MCP_CONTEXT_SIZE:-}",
        "VERIFY_MCP_ENV": "${VERIFY_MCP_ENV:-}"
      }
    }
  }
}
